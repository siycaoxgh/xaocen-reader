diff --git a/engine/src/flutter/shell/platform/windows/egl/dcomp_window_surface.cc b/engine/src/flutter/shell/platform/windows/egl/dcomp_window_surface.cc
new file mode 100644
index 00000000000..383c9db7f28
--- /dev/null
+++ b/engine/src/flutter/shell/platform/windows/egl/dcomp_window_surface.cc
@@ -0,0 +1,289 @@
+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#include "flutter/shell/platform/windows/egl/dcomp_window_surface.h"
+
+#include <EGL/eglext.h>
+
+#include <algorithm>
+#include <string_view>
+
+#include "flutter/fml/logging.h"
+#include "flutter/shell/platform/windows/egl/egl.h"
+#include "flutter/shell/platform/windows/egl/manager.h"
+
+#pragma comment(lib, "dcomp.lib")
+#pragma comment(lib, "d3d11.lib")
+#pragma comment(lib, "dxgi.lib")
+
+namespace flutter {
+namespace egl {
+
+namespace {
+
+constexpr DXGI_FORMAT kFormat = DXGI_FORMAT_B8G8R8A8_UNORM;
+constexpr DXGI_ALPHA_MODE kAlphaMode = DXGI_ALPHA_MODE_PREMULTIPLIED;
+
+void LogHr(const char* operation, HRESULT hr) {
+  FML_LOG(ERROR) << operation << " failed: 0x" << std::hex
+                 << static_cast<unsigned long>(hr);
+}
+
+bool HasExtension(EGLDisplay display, const char* name) {
+  const char* extensions = ::eglQueryString(display, EGL_EXTENSIONS);
+  if (extensions == nullptr) {
+    return false;
+  }
+  std::string_view all(extensions);
+  std::string_view needle(name);
+  size_t offset = 0;
+  while (offset < all.size()) {
+    size_t end = all.find(' ', offset);
+    if (end == std::string_view::npos) {
+      end = all.size();
+    }
+    if (all.substr(offset, end - offset) == needle) {
+      return true;
+    }
+    offset = end + 1;
+  }
+  return false;
+}
+
+}  // namespace
+
+DCompWindowSurface::DCompWindowSurface(EGLDisplay display,
+                                       EGLContext context,
+                                       size_t width,
+                                       size_t height)
+    : WindowSurface(display, context, EGL_NO_SURFACE, width, height) {}
+
+DCompWindowSurface::~DCompWindowSurface() {
+  Destroy();
+}
+
+std::unique_ptr<DCompWindowSurface> DCompWindowSurface::Create(
+    Manager* manager,
+    HWND hwnd,
+    size_t width,
+    size_t height) {
+  if (manager == nullptr || hwnd == nullptr || width == 0 || height == 0) {
+    return nullptr;
+  }
+
+  auto surface = std::unique_ptr<DCompWindowSurface>(new DCompWindowSurface(
+      manager->egl_display(), manager->render_context()->GetHandle(), width,
+      height));
+  if (!surface->Initialize(manager, hwnd)) {
+    return nullptr;
+  }
+  return surface;
+}
+
+bool DCompWindowSurface::Initialize(Manager* manager, HWND hwnd) {
+  manager_ = manager;
+  hwnd_ = hwnd;
+
+  if (!HasExtension(display_, "EGL_ANGLE_d3d_share_handle_client_buffer") &&
+      !HasExtension(display_,
+                    "EGL_ANGLE_surface_d3d_texture_2d_share_handle")) {
+    FML_LOG(WARNING)
+        << "Transparent surface disabled: ANGLE shared-handle extension is "
+           "unavailable";
+    return false;
+  }
+
+  if (!CreateSwapchainAndComposition(manager, hwnd)) {
+    return false;
+  }
+  if (!ImportBackbuffer(manager)) {
+    return false;
+  }
+  is_valid_ = true;
+  return true;
+}
+
+bool DCompWindowSurface::CreateSwapchainAndComposition(Manager* manager,
+                                                        HWND hwnd) {
+  if (!manager->GetDevice(d3d_device_.GetAddressOf())) {
+    FML_LOG(WARNING) << "Transparent surface disabled: ANGLE D3D device "
+                        "could not be queried";
+    return false;
+  }
+
+  Microsoft::WRL::ComPtr<IDXGIDevice> dxgi_device;
+  HRESULT hr = d3d_device_.As(&dxgi_device);
+  if (FAILED(hr)) {
+    LogHr("Query IDXGIDevice", hr);
+    return false;
+  }
+
+  Microsoft::WRL::ComPtr<IDXGIFactory2> factory;
+  hr = ::CreateDXGIFactory2(0, IID_PPV_ARGS(&factory));
+  if (FAILED(hr)) {
+    LogHr("CreateDXGIFactory2", hr);
+    return false;
+  }
+
+  DXGI_SWAP_CHAIN_DESC1 description = {};
+  description.Width = static_cast<UINT>(width());
+  description.Height = static_cast<UINT>(height());
+  description.Format = kFormat;
+  description.SampleDesc.Count = 1;
+  description.BufferUsage = DXGI_USAGE_RENDER_TARGET_OUTPUT;
+  description.BufferCount = 2;
+  description.Scaling = DXGI_SCALING_STRETCH;
+  description.SwapEffect = DXGI_SWAP_EFFECT_FLIP_SEQUENTIAL;
+  description.AlphaMode = kAlphaMode;
+  // The shared flag is required for a swapchain buffer to expose a D3D
+  // interop handle. If a driver rejects the combination, creation fails and
+  // the caller falls back to the normal opaque ANGLE window surface.
+  description.Flags = DXGI_SWAP_CHAIN_FLAG_SHARED;
+
+  hr = factory->CreateSwapChainForComposition(
+      d3d_device_.Get(), &description, nullptr, swapchain_.GetAddressOf());
+  if (FAILED(hr)) {
+    LogHr("CreateSwapChainForComposition", hr);
+    return false;
+  }
+
+  hr = ::DCompositionCreateDevice(dxgi_device.Get(),
+                                  IID_PPV_ARGS(&dcomp_device_));
+  if (FAILED(hr)) {
+    LogHr("DCompositionCreateDevice", hr);
+    return false;
+  }
+  hr = dcomp_device_->CreateTargetForHwnd(hwnd, TRUE,
+                                          dcomp_target_.GetAddressOf());
+  if (FAILED(hr)) {
+    LogHr("CreateTargetForHwnd", hr);
+    return false;
+  }
+  hr = dcomp_device_->CreateVisual(dcomp_visual_.GetAddressOf());
+  if (FAILED(hr)) {
+    LogHr("CreateVisual", hr);
+    return false;
+  }
+  hr = dcomp_visual_->SetContent(swapchain_.Get());
+  if (FAILED(hr)) {
+    LogHr("Visual.SetContent", hr);
+    return false;
+  }
+  hr = dcomp_target_->SetRoot(dcomp_visual_.Get());
+  if (FAILED(hr)) {
+    LogHr("Target.SetRoot", hr);
+    return false;
+  }
+  hr = dcomp_device_->Commit();
+  if (FAILED(hr)) {
+    LogHr("DComp Commit", hr);
+    return false;
+  }
+  composition_committed_ = true;
+  return true;
+}
+
+bool DCompWindowSurface::ImportBackbuffer(Manager* manager) {
+  Microsoft::WRL::ComPtr<ID3D11Texture2D> backbuffer;
+  HRESULT hr = swapchain_->GetBuffer(0, IID_PPV_ARGS(&backbuffer));
+  if (FAILED(hr)) {
+    LogHr("Swapchain.GetBuffer", hr);
+    return false;
+  }
+
+  Microsoft::WRL::ComPtr<IDXGIResource1> resource;
+  hr = backbuffer.As(&resource);
+  if (FAILED(hr)) {
+    LogHr("Backbuffer.Query IDXGIResource1", hr);
+    return false;
+  }
+
+  hr = resource->CreateSharedHandle(
+      nullptr, DXGI_SHARED_RESOURCE_READ | DXGI_SHARED_RESOURCE_WRITE, nullptr,
+      &shared_handle_);
+  if (FAILED(hr) || shared_handle_ == nullptr) {
+    // Older ANGLE/driver combinations expose the legacy shared handle for a
+    // swapchain backbuffer even when IDXGIResource1 cannot create an NT
+    // handle. It is still GPU-to-GPU interop; the handle is retained until
+    // EGL destroys the imported surface.
+    Microsoft::WRL::ComPtr<IDXGIResource> legacy_resource;
+    if (SUCCEEDED(backbuffer.As(&legacy_resource))) {
+      hr = legacy_resource->GetSharedHandle(&shared_handle_);
+    }
+  }
+  if (FAILED(hr) || shared_handle_ == nullptr) {
+    LogHr("Backbuffer shared-handle export", hr);
+    return false;
+  }
+
+  const EGLint attributes[] = {
+      EGL_WIDTH,
+      static_cast<EGLint>(width()),
+      EGL_HEIGHT,
+      static_cast<EGLint>(height()),
+      EGL_NONE,
+  };
+  EGLSurface imported = manager->CreateSurfaceFromHandle(
+      EGL_D3D_TEXTURE_2D_SHARE_HANDLE_ANGLE,
+      reinterpret_cast<EGLClientBuffer>(shared_handle_), attributes);
+  if (imported == EGL_NO_SURFACE) {
+    LogEGLError("ANGLE failed to import DComp swapchain shared handle");
+    ReleaseSharedHandle();
+    return false;
+  }
+  surface_ = imported;
+  return true;
+}
+
+void DCompWindowSurface::ReleaseSharedHandle() {
+  if (shared_handle_ != nullptr) {
+    ::CloseHandle(shared_handle_);
+    shared_handle_ = nullptr;
+  }
+}
+
+bool DCompWindowSurface::Destroy() {
+  bool result = true;
+  if (surface_ != EGL_NO_SURFACE) {
+    result = WindowSurface::Destroy();
+  }
+  ReleaseSharedHandle();
+  dcomp_visual_.Reset();
+  dcomp_target_.Reset();
+  if (dcomp_device_ && composition_committed_) {
+    dcomp_device_->Commit();
+  }
+  dcomp_device_.Reset();
+  swapchain_.Reset();
+  d3d_device_.Reset();
+  manager_ = nullptr;
+  hwnd_ = nullptr;
+  composition_committed_ = false;
+  return result;
+}
+
+bool DCompWindowSurface::SwapBuffers() const {
+  // eglSwapBuffers on the imported pbuffer is used as the existing ANGLE
+  // flush/present boundary. No pixels are read back or copied to the CPU.
+  if (::eglSwapBuffers(display_, surface_) != EGL_TRUE) {
+    WINDOWS_LOG_EGL_ERROR;
+    return false;
+  }
+
+  const UINT sync_interval = vsync_enabled() ? 1 : 0;
+  HRESULT hr = swapchain_->Present(sync_interval, 0);
+  if (FAILED(hr)) {
+    LogHr("DComp swapchain Present", hr);
+    return false;
+  }
+  hr = dcomp_device_->Commit();
+  if (FAILED(hr)) {
+    LogHr("DComp frame Commit", hr);
+    return false;
+  }
+  return true;
+}
+
+}  // namespace egl
+}  // namespace flutter
