+// Copyright 2013 The Flutter Authors. All rights reserved.
+// Use of this source code is governed by a BSD-style license that can be
+// found in the LICENSE file.
+
+#ifndef FLUTTER_SHELL_PLATFORM_WINDOWS_EGL_DCOMP_WINDOW_SURFACE_H_
+#define FLUTTER_SHELL_PLATFORM_WINDOWS_EGL_DCOMP_WINDOW_SURFACE_H_
+
+#include <EGL/egl.h>
+
+#include <windows.h>
+#include <d3d11.h>
+#include <dcomp.h>
+#include <dxgi1_2.h>
+#include <wrl/client.h>
+
+#include <memory>
+
+#include "flutter/fml/macros.h"
+#include "flutter/shell/platform/windows/egl/window_surface.h"
+
+namespace flutter {
+namespace egl {
+
+class Manager;
+
+// A Windows-only EGL surface backed by a DirectComposition swapchain.
+//
+// This class deliberately keeps the existing WindowSurface contract so the
+// OpenGL compositor, input, focus, and accessibility paths remain unchanged.
+// The swapchain backbuffer is imported into ANGLE through its D3D shared-handle
+// client-buffer extension; no CPU readback or per-frame texture copy is used.
+class DCompWindowSurface final : public WindowSurface {
+ public:
+  static std::unique_ptr<DCompWindowSurface> Create(
+      Manager* manager,
+      HWND hwnd,
+      size_t width,
+      size_t height);
+
+  ~DCompWindowSurface() override;
+
+  bool Destroy() override;
+  bool SwapBuffers() const override;
+
+ private:
+  DCompWindowSurface(EGLDisplay display,
+                     EGLContext context,
+                     size_t width,
+                     size_t height);
+
+  bool Initialize(Manager* manager, HWND hwnd);
+  bool CreateSwapchainAndComposition(Manager* manager, HWND hwnd);
+  bool ImportBackbuffer(Manager* manager);
+  void ReleaseSharedHandle();
+
+  Manager* manager_ = nullptr;  // Not owned; manager outlives the surface.
+  HWND hwnd_ = nullptr;
+
+  Microsoft::WRL::ComPtr<ID3D11Device> d3d_device_;
+  Microsoft::WRL::ComPtr<IDXGISwapChain1> swapchain_;
+  Microsoft::WRL::ComPtr<IDCompositionDevice> dcomp_device_;
+  Microsoft::WRL::ComPtr<IDCompositionTarget> dcomp_target_;
+  Microsoft::WRL::ComPtr<IDCompositionVisual> dcomp_visual_;
+  HANDLE shared_handle_ = nullptr;
+  bool composition_committed_ = false;
+
+  FML_DISALLOW_COPY_AND_ASSIGN(DCompWindowSurface);
+};
+
+}  // namespace egl
+}  // namespace flutter
+
+#endif  // FLUTTER_SHELL_PLATFORM_WINDOWS_EGL_DCOMP_WINDOW_SURFACE_H_
